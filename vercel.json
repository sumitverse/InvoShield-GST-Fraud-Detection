{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/$",
      "dest": "/frontend/public/login.html"
    },
    {
      "src": "^/public/(.*)$",
      "dest": "/frontend/public/$1"
    },
    {
      "src": "^/css/(.*)$",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "^/js/(.*)$",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "^/login(\\.html)?$",
      "dest": "/frontend/public/login.html"
    },
    {
      "src": "^/dashboard(\\.html)?$",
      "dest": "/frontend/public/dashboard.html"
    },
    {
      "src": "^/invoices(\\.html)?$",
      "dest": "/frontend/public/invoices.html"
    },
    {
      "src": "^/fraud-alert(\\.html)?$",
      "dest": "/frontend/public/fraud-alert.html"
    },
    {
      "src": "^/gstin-lookup(\\.html)?$",
      "dest": "/frontend/public/gstin-lookup.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/frontend/public/$1"
    }
  ]
}
